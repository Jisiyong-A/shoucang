{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "收藏",
  "version": "0.1.0",
  "identifier": "com.patrick.shoucang",
  "build": {
    "beforeDevCommand": "npm run desktop:preview",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http://127.0.0.1:4318; connect-src 'self' http://127.0.0.1:4318"
    },
    "windows": [
      {
        "title": "收藏",
        "width": 1440,
        "height": 960,
        "minWidth": 1080,
        "minHeight": 760,
        "maximized": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "licenseFile": "../LICENSE",
    "resources": {
      "resources/node/node.exe": "node/node.exe",
      "../scripts/local-api.mjs": "local-api.mjs",
      "../scripts/shoucang-mcp.mjs": "shoucang-mcp.mjs",
      "../scripts/macos-vision-ocr.js": "macos-vision-ocr.js",
      "../scripts/windows-ocr.ps1": "windows-ocr.ps1",
      "../scripts/lib/anonymous-note-resolver.mjs": "lib/anonymous-note-resolver.mjs",
      "../scripts/lib/cache-cover-recovery.mjs": "lib/cache-cover-recovery.mjs",
      "../scripts/lib/category-inference.mjs": "lib/category-inference.mjs",
      "../scripts/lib/media-import.mjs": "lib/media-import.mjs",
      "../scripts/ocr/index.mjs": "ocr/index.mjs",
      "../scripts/ocr/types.mjs": "ocr/types.mjs",
      "../scripts/ocr/normalize.mjs": "ocr/normalize.mjs",
      "../scripts/ocr/macos-vision.mjs": "ocr/macos-vision.mjs",
      "../scripts/ocr/windows-local.mjs": "ocr/windows-local.mjs",
      "../scripts/lib/ai-classifier.mjs": "lib/ai-classifier.mjs",
      "../scripts/lib/note-import.mjs": "lib/note-import.mjs",
      "../scripts/lib/note-search.mjs": "lib/note-search.mjs",
      "../scripts/platform/index.mjs": "platform/index.mjs",
      "../scripts/platform/common.mjs": "platform/common.mjs",
      "../scripts/platform/windows.mjs": "platform/windows.mjs",
      "../scripts/platform/macos.mjs": "platform/macos.mjs",
      "../browser-extension/manifest.json": "browser-extension/manifest.json",
      "../browser-extension/background.js": "browser-extension/background.js",
      "../browser-extension/content.js": "browser-extension/content.js",
      "../browser-extension/page-data.js": "browser-extension/page-data.js"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
